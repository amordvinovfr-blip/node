+                ['session_rate_burst', 'candidate', 'alert'],
+                ['session_rate_burst', 'confirmed', 'alert'],
+            ],
+        );
+        assert.ok(results.every((result) => !result.shouldBlock));
+    });
+
+    it('does not count 80/443', () => {
